<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Not for drawing an overlay. On Android 14 this appop is what exempts us from
         background-activity-start restrictions, which is the only way a sideloaded app
         can put a window up while the screen is off. Granted over adb; LightOS has no
         Settings UI for it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Glance"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightGlance">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Glance"
            android:theme="@style/Theme.LightGlance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GlanceActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="com.gios.lightglance.aod"
            android:theme="@style/Theme.LightGlance.Aod" />

        <!-- Requested over adb, used only for force-lock. Finishing the ambient surface
             has to actively put the panel back to sleep, otherwise the dwell timer only
             decides when we stop drawing, not when the screen goes dark. -->
        <receiver
            android:name=".admin.GlanceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- The system binds and keeps this alive, so it doubles as the app's long-lived
             component. No foreground service, and therefore no permanent notification
             of our own polluting the very list we are reading. -->
        <service
            android:name=".notif.NotifListener"
            android:exported="false"
            android:label="Glance"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
