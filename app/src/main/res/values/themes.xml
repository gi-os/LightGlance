<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LightGlance" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The ambient surface. No animations: a fade would be a bright flash of
         compositing work every time a text arrives at 3am. -->
    <style name="Theme.LightGlance.Aod" parent="Theme.LightGlance">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
